{
  "name": "surfacepin",
  "version": "1.5.0",
  "description": "Lock exact hashes of MCP tools/resources/prompts list surfaces; fail CI on silent drift. Offline files or live --stdio. Lockfile v3 structured field-diff (COMPATIBLE|BREAKING|HINT_FLIP).",
  "license": "MIT",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "surfacepin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "sdk-path": "npm run build && node examples/sdk-default-path/check.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "tools",
    "resources",
    "prompts",
    "lockfile",
    "ci",
    "hash",
    "surface"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/surfacepin.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/surfacepin/issues"
  },
  "homepage": "https://www.yellowgram.dev/oss",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
