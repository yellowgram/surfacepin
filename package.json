{
  "name": "surfacepin",
  "version": "1.2.0",
  "description": "Lock exact hashes of MCP tools/resources/prompts list surfaces; fail CI on silent drift. Offline files or live --stdio.",
  "license": "MIT",
  "author": "yellowgram",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "surfacepin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "tools",
    "resources",
    "prompts",
    "lockfile",
    "ci",
    "hash",
    "surface"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/surfacepin.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/surfacepin/issues"
  },
  "homepage": "https://github.com/yellowgram/surfacepin#readme",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
